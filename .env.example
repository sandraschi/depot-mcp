# depot-mcp — copy to .env and adjust. Never commit .env (only this template).
# Tier roots (created automatically if missing)
DEPOT_FAST_ROOT=D:\depot\fast
DEPOT_SLOW_ROOT=E:\depot\slow

# Index + data
# LanceDB dir / FTS5 sidecar / fleet-error sink DB live under data/
# (data/ is gitignored; fleet_errors.sqlite3 rebuilds empty)

# Tiering policy: lru | explicit | tag_based
DEPOT_TIER_POLICY=lru
DEPOT_LRU_TTL_DAYS=7

# Uploads
DEPOT_CHUNK_SIZE_MB=64
DEPOT_MAX_UPLOAD_SIZE_GB=100

# Bind
DEPOT_HOST=127.0.0.1
DEPOT_PORT=10727

# Embeddings (fastembed)
DEPOT_EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
DEPOT_EMBEDDING_DIM=384

# LLM auto-glom (1 = probe Ollama :11434 / LM Studio :1234 on boot)
DEPOT_MCP_LLM_GLOM=1

# MCP HTTP probe for stdio proxy mode
DEPOT_MCP_API_URL=http://127.0.0.1:10727/mcp
